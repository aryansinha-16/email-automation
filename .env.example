# Copy to .env and fill in. NEVER commit .env (it's gitignored).

GMAIL_CLIENT_ID=1062923913182-35c6hadolm642amoloqq88rj3goh2ems.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated. Use a bare email for one address, or @domain for a whole domain.
# Example: ops@acme.com,@partner.com
ALLOWED_SENDERS=

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Optional
POLL_SECONDS=60
GROQ_MODEL=llama-3.3-70b-versatile
HANDLED_LABEL=AutoReplied
# Set to 1 to LOG replies instead of sending (use this first!)
DRY_RUN=1
